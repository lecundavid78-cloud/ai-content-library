      "cue": 6,
      "show": 17.92,
      "hide": 21.879,
      "seconds": 3.96,
      "en_lines": 2,
      "zh_lines": 2,
      "en_px": 54,
      "zh_px": 42,
      "en_cps": 13.6,
      "zh_cps": 5.3,
      "zh_break_needs_eyeball": false,
      "en": "Offended, I sent a follow-up: \"Have you forgotten me?\""
