      "zh_px": 42,
      "en_cps": 16.2,
      "zh_cps": 4.3,
      "zh_break_needs_eyeball": false,
      "en": "\"Please open the bedroom door. It's dinner time.\""
    },
    {
      "cue": 3,
      "show": 7.379,
      "hide": 10.044,
      "seconds": 2.67,
      "en_lines": 1,
      "zh_lines": 1,
      "en_px": 54,
      "zh_px": 42,
      "en_cps": 13.1,
      "zh_cps": 6.0,
      "zh_break_needs_eyeball": false,
      "en": "For nearly an hour, I got no reply."
    },
    {
      "cue": 4,
      "show": 10.438,
      "hide": 13.432,
      "seconds": 2.99,
      "en_lines": 2,
      "zh_lines": 1,
      "en_px": 54,
      "zh_px": 42,
      "en_cps": 16.7,
      "zh_cps": 4.3,
      "zh_break_needs_eyeball": false,
      "en": "I stared at the screen and began to lose patience."
    },
